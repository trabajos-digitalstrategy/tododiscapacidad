---
layout: layout/base.njk
colorHeader: has-light-menu
editorial: true
---

{% import "macros/_insert.njk" as insert %}

<article class="ed-blog-post">

  {# ============= HERO ============= #}
  <section class="ed-article-hero ed-section" style="padding-bottom: 0;">
    <div class="ed-wrap">
      <div class="ed-article-meta">
        <span>{{ page.date | date('DD MMM YYYY', 'es') }}</span>
        <span class="dot">·</span>
        <span>5 min de lectura</span>
        {% if author %}
        <span class="dot">·</span>
        <span>{{ author }}</span>
        {% endif %}
        {% if tags %}
          {% for t in tags %}
            {% if t != 'blog' and t != 'pages' %}
              <span class="dot">·</span>
              <span>{{ t }}</span>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>

      <h1>{{ title }}</h1>
      {% if subtitle %}<p class="ed-article-sub">{{ subtitle }}</p>{% endif %}

      {% if image %}
      <div class="ed-article-cover">
        <img src="{{ image }}" alt="{{ imageAlt or title }}" loading="eager" />
      </div>
      {% endif %}
    </div>
  </section>

  {# ============= CONTENIDO ============= #}
  <div class="ed-article-body innermarkdown">
    {{ content | safe }}
  </div>

  {# ============= CTA in-article ============= #}
  <section class="ed-cta ed-section--flush" style="padding-top: clamp(32px, 5vw, 64px);">
    <div class="ed-cta-card">
      <div class="ed-cta-inner">
        <span class="ed-eyebrow ed-eyebrow--rule">¿Te ha sido útil este artículo?</span>
        <h2>Si tienes <em>una consulta</em> sobre tu caso, escríbenos.</h2>
        <p>Asesoramiento personalizado por un abogado especializado en derecho laboral y discapacidad. Respuesta &lt; 48&nbsp;h.</p>
        <div class="ed-cta-actions">
          <a href="/contacta/" class="ed-btn-primary">Contactar <span>→</span></a>
          <a href="/sobre-pedro-lopez-cerro/" class="ed-btn-secondary">Sobre Pedro</a>
        </div>
      </div>
    </div>
  </section>

  {# ============= PAGINACIÓN ============= #}
  {% set next = collections.blog | nextInCollection(page.fileSlug) %}
  {% set previous = collections.blog | prevInCollection(page.fileSlug) %}
  {% if next or previous %}
    <nav class="ed-pagination" aria-label="Más artículos">
      {% if previous %}
        <a href="{{ previous.url }}" rel="prev">
          <div class="label">← Post anterior</div>
          <div class="title">{{ previous.data.title }}</div>
        </a>
      {% else %}
        <span></span>
      {% endif %}
      {% if next %}
        <a href="{{ next.url }}" class="next" rel="next">
          <div class="label">Siguiente post →</div>
          <div class="title">{{ next.data.title }}</div>
        </a>
      {% else %}
        <span></span>
      {% endif %}
    </nav>
  {% endif %}

</article>
