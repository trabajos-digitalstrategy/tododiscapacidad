<!-- box_img.njk -->
<section class=" herohome inview  o-hidden   bg-hero  height-full p-relative  " aria-labelledby="seccion-autor">
  <div class="parallax-container" style="background-image: url('{{ box_img_img }}');" role="img" aria-label="Pedro López Cerro - Abogado experto en derecho de discapacidad">
    <div class=" container-global mx-auto    ">
      <div class="row section-x  align-middle  height-full box_img ">
        <div class="col-xs-9 col-md-5 col-lg-5 height-sm  ">
        </div>
        <div class="col-xs-12 col-md-1 col-lg-1 "></div>
        <div class="col-xs-12 col-md-6 col-lg-6 front-text is-flex content-end ">
          <article class="bg-white text-left p-24 mb-32 border-20 wmax-450" itemscope itemtype="https://schema.org/Person">
            <h2 id="seccion-autor" class="h4 mb-32 animate-word" data-delay="0" itemprop="name">
              {{box_img_title}}
            </h2>
            <p class="p1 mb-16 animate-word" data-delay="1" itemprop="description">
              {{box_img_description}}
            </p>
            {% if box_img_description2 %}
            <div class="p2 mb-16 animate-word" data-delay="2">
              {{ box_img_description2 | mdbr | safe }}
            </div>
            {% endif %}
            <meta itemprop="jobTitle" content="Abogado experto en derecho laboral y discapacidad" />
            <meta itemprop="url" content="{{ global_index.url }}/sobre-pedro-lopez-cerro/" />
            <div class="animate-box2  mt-24" data-delay="3">
              <a href="/sobre-pedro-lopez-cerro/">
                <button type="button" class="btn-black btn ">
                  Conoce más sobre Pedro
                </button>
              </a>
            </div>
          </article>
        </div>
      </div>
    </div>
</section>
