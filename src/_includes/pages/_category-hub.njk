---
layout: layout/base.njk
colorHeader: has-light-menu
editorial: true
---

{% import "macros/_insert.njk" as insert %}

<main class="ed-category-hub">

  {# ============= HERO ============= #}
  <section class="ed-hero ed-section">
    <div class="ed-wrap">
      <div class="ed-hero-grid ed-hero-grid--single">
        <div>
          {% if hero_kicker %}
          <div class="ed-hero-eyebrow">
            <span class="ed-eyebrow ed-eyebrow--rule">{{ hero_kicker }}</span>
          </div>
          {% endif %}
          <h1 class="ed-display">{{ title }}</h1>
          {% if subtitle %}<p class="ed-hero-role" style="max-width:38ch;">{{ subtitle }}</p>{% endif %}
        </div>
      </div>
    </div>
  </section>

  {# ============= INTRO ============= #}
  {% if intro_html %}
  <section class="ed-section" style="padding-top: 0;">
    <div class="ed-wrap">
      <article class="ed-article-body" style="max-width: 880px; margin: 0 auto; padding: 0;">
        {{ intro_html | safe }}
      </article>
    </div>
  </section>
  {% endif %}

  {# ============= ARTÍCULOS RELACIONADOS ============= #}
  {% if categoryTags %}
  <section class="ed-section">
    <div class="ed-wrap">
      <div class="ed-areas-header" style="margin-bottom: 40px;">
        <div>
          <div class="ed-eyebrow">Artículos</div>
          <h2 class="ed-section-title" style="margin-top:18px;">Análisis &amp; <em>guías</em>.</h2>
          <p class="ed-body" style="margin-top: 14px; max-width: 56ch;">Casos reales, sentencias explicadas y guías prácticas sobre {{ title | lower }}.</p>
        </div>
      </div>

      {% set sortedPosts = collections.blog | sort(false, false, 'date') | reverse %}
      {% set foundPosts = 0 %}
      <div class="ed-posts-grid">
        {% for post in sortedPosts %}
          {% if post.data.tags %}
            {% set matches = false %}
            {% for postTag in post.data.tags %}
              {% for catTag in categoryTags %}
                {% if postTag | lower == catTag | lower %}{% set matches = true %}{% endif %}
              {% endfor %}
            {% endfor %}
            {% if matches and post.data.title and post.data.title != 'titulo' %}
              {% set foundPosts = foundPosts + 1 %}
              <a href="{{ post.url }}" class="ed-post-card">
                {% if post.data.image %}
                <div class="img">
                  <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt or post.data.title }}" loading="lazy">
                </div>
                {% endif %}
                <div class="body">
                  <div class="date">{{ post.data.date | date('DD/MM/YYYY', 'es') }}</div>
                  <h3 class="title">{{ post.data.title }}</h3>
                  {% if post.data.subtitle %}<p class="excerpt">{{ post.data.subtitle }}</p>{% endif %}
                  <span class="more">Leer artículo</span>
                </div>
              </a>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>

      {% if foundPosts == 0 %}
      <div class="ed-faq" style="text-align: center;">
        <p class="ed-body" style="margin-bottom: 18px;">Aún no hemos publicado artículos en esta categoría, pero estamos preparando contenido.</p>
        <a href="/blog/" class="ed-btn-primary" style="background: var(--ed-cyan);">Ver todos los artículos</a>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {# ============= FAQ ============= #}
  {% if faqs %}
  <section class="ed-section" style="background: var(--ed-cream);">
    <div class="ed-wrap">
      <div class="ed-areas-header" style="margin-bottom: 40px;">
        <div>
          <div class="ed-eyebrow">Preguntas frecuentes</div>
          <h2 class="ed-section-title" style="margin-top:18px;">Lo que <em>más se pregunta</em>.</h2>
        </div>
      </div>
      <div class="ed-faq">
        {% for faq in faqs %}
          <details>
            <summary>{{ faq.q }}</summary>
            <div class="ed-faq-answer">{{ faq.a | safe }}</div>
          </details>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ============= CTA ============= #}
  <section class="ed-cta ed-section--flush" style="padding-top: clamp(64px, 9vw, 120px);">
    <div class="ed-cta-card">
      <div class="ed-cta-inner">
        <span class="ed-eyebrow ed-eyebrow--rule">Asesoramiento personalizado</span>
        <h2>¿Necesitas ayuda con <em>tu caso?</em></h2>
        <p>Contacta con un abogado especializado en derecho de discapacidad para resolver tu situación concreta. Te respondo en menos de 48 horas.</p>
        <div class="ed-cta-actions">
          <a href="/contacta/" class="ed-btn-primary">Contactar ahora <span>→</span></a>
          <a href="/sobre-pedro-lopez-cerro/" class="ed-btn-secondary">Sobre Pedro</a>
        </div>
      </div>
    </div>
  </section>

</main>
