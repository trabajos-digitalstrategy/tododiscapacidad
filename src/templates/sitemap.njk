---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">
    {%- set excludedPaths = ['/admin/', '/site/', '/site.html', '/templates/', '/password-recovery/', '/password-recovery.html', '/home/', '/ejemplohtml/', '/private/', '/temp/'] -%}
    {%- for page in collections.all -%}
        {%- set url = page.url -%}
        {%- set isExcluded = false -%}
        {%- for excluded in excludedPaths -%}
            {%- if url and url.startsWith(excluded) -%}
                {%- set isExcluded = true -%}
            {%- endif -%}
        {%- endfor -%}
        {%- if url and not isExcluded and url != false -%}
    <url>
        <loc>{{ global_index.url }}{{ url | url }}</loc>
        <lastmod>{{ page.date.toISOString() }}</lastmod>
        {%- if url == '/' %}
        <changefreq>weekly</changefreq>
        <priority>1.0</priority>
        {%- elif url.startsWith('/blog/') and url != '/blog/' %}
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
        {%- elif url == '/blog/' %}
        <changefreq>weekly</changefreq>
        <priority>0.9</priority>
        {%- elif url.startsWith('/legal/') %}
        <changefreq>yearly</changefreq>
        <priority>0.3</priority>
        {%- else %}
        <changefreq>monthly</changefreq>
        <priority>0.6</priority>
        {%- endif %}
    </url>
        {%- endif -%}
    {%- endfor %}
</urlset>
