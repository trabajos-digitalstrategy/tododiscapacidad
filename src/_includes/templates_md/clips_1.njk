<!-- clips_1.njk -->

<section class=" pbr-120" aria-labelledby="seccion-clips">
  <div class="container ">


    <div class=" border-20 height-sm p-32">
      <div class="row">
        <div class="col-xs-12 text-center">
          <h2 id="seccion-clips" class="fluid-6-b mb-8">{{ clips_title | mdbr | safe }}</h2>
          <p class="fluid-9-r mb-64">
            {{ clips_description }}
          </p>
        </div>
      </div>

      <div class="row">
        {% if clips_video_1 %}
        <div class="col-xs-6 col-md-3 mb-16">
          <div class="clips-video-container">
            <a href="https://youtube.com/shorts/{{ clips_video_1 }}" target="_blank" rel="noopener noreferrer" class="clips-video-link" aria-label="Ver clip: {{ clips_video_1_title or 'sobre derechos de discapacidad en España' }}">
              <div class="clips-video-thumbnail">
                <img src="https://img.youtube.com/vi/{{ clips_video_1 }}/maxresdefault.jpg" alt="{{ clips_video_1_alt or 'Clip de Pedro López Cerro explicando derechos de discapacidad' }}" class="w-100" loading="lazy" width="480" height="360">
                <div class="clips-play-button" aria-hidden="true">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="10" fill="rgba(0,0,0,0.7)"/>
                    <path d="M10 8L16 12L10 16V8Z" fill="white"/>
                  </svg>
                </div>
              </div>
            </a>
          </div>
        </div>
        {% endif %}

        {% if clips_video_2 %}
        <div class="col-xs-6 col-md-3 mb-16">
          <div class="clips-video-container">
            <a href="https://youtube.com/shorts/{{ clips_video_2 }}" target="_blank" rel="noopener noreferrer" class="clips-video-link" aria-label="Ver clip: {{ clips_video_2_title or 'sentencias sobre incapacidad' }}">
              <div class="clips-video-thumbnail">
                <img src="https://img.youtube.com/vi/{{ clips_video_2 }}/maxresdefault.jpg" alt="{{ clips_video_2_alt or 'Clip explicando sentencias sobre incapacidad y discapacidad' }}" class="w-100" loading="lazy" width="480" height="360">
                <div class="clips-play-button" aria-hidden="true">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="10" fill="rgba(0,0,0,0.7)"/>
                    <path d="M10 8L16 12L10 16V8Z" fill="white"/>
                  </svg>
                </div>
              </div>
            </a>
          </div>
        </div>
        {% endif %}

        {% if clips_video_3 %}
        <div class="col-xs-6 col-md-3 mb-16">
          <div class="clips-video-container">
            <a href="https://youtube.com/shorts/{{ clips_video_3 }}" target="_blank" rel="noopener noreferrer" class="clips-video-link" aria-label="Ver clip: {{ clips_video_3_title or 'ayudas y prestaciones por discapacidad' }}">
              <div class="clips-video-thumbnail">
                <img src="https://img.youtube.com/vi/{{ clips_video_3 }}/maxresdefault.jpg" alt="{{ clips_video_3_alt or 'Clip sobre ayudas y prestaciones por discapacidad en España' }}" class="w-100" loading="lazy" width="480" height="360">
                <div class="clips-play-button" aria-hidden="true">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="10" fill="rgba(0,0,0,0.7)"/>
                    <path d="M10 8L16 12L10 16V8Z" fill="white"/>
                  </svg>
                </div>
              </div>
            </a>
          </div>
        </div>
        {% endif %}

        {% if clips_video_4 %}
        <div class="col-xs-6 col-md-3 mb-16">
          <div class="clips-video-container">
            <a href="https://youtube.com/shorts/{{ clips_video_4 }}" target="_blank" rel="noopener noreferrer" class="clips-video-link" aria-label="Ver clip: {{ clips_video_4_title or 'patrimonio protegido y conciliación' }}">
              <div class="clips-video-thumbnail">
                <img src="https://img.youtube.com/vi/{{ clips_video_4 }}/maxresdefault.jpg" alt="{{ clips_video_4_alt or 'Clip sobre patrimonio protegido y conciliación familiar' }}" class="w-100" loading="lazy" width="480" height="360">
                <div class="clips-play-button" aria-hidden="true">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="12" r="10" fill="rgba(0,0,0,0.7)"/>
                    <path d="M10 8L16 12L10 16V8Z" fill="white"/>
                  </svg>
                </div>
              </div>
            </a>
          </div>
        </div>
        {% endif %}
      </div>
    </div>

  </div>
</section>
